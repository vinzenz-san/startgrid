{
  "name": "firefox-addon-startpage",
  "version": "1.19.2",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "browserslist": [
    "last 2 Firefox versions",
    "Firefox ESR",
    "last 2 Chrome versions"
  ],
  "scripts": {
    "dev": "rspack build --watch --env target=firefox",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "build:firefox": "rspack build --env target=firefox --env production=true && node scripts/patch-runtime.js dist/firefox/newtab.js",
    "build:chrome": "rspack build --env target=chrome --env production=true && node scripts/patch-runtime.js dist/chrome/newtab.js",
    "build:chrome-store": "rspack build --env target=chrome --env production=true --env store=true && node scripts/patch-runtime.js dist/chrome-store/newtab.js",
    "build": "pnpm build:firefox && pnpm build:chrome",
    "build:preview": "pnpm build:chrome && node scripts/sync-preview.js",
    "preview": "npx serve dist/firefox -p 4747 --no-clipboard",
    "preview:docs": "npx serve docs/preview -p 5173 --no-clipboard",
    "render:promo": "node scripts/render-promo.js",
    "package:firefox": "node scripts/package-zip.js firefox",
    "package:chrome": "node scripts/package-zip.js chrome",
    "package:chrome-store": "node scripts/package-zip.js chrome-store"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.4",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^1.3.0",
    "@rspack/core": "^1.3.0",
    "@types/chrome": "^0.2.2",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/webextension-polyfill": "^0.10.0",
    "archiver": "^7.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "puppeteer": "^25.4.0",
    "serve": "^14.2.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0"
  }
}
