# Media Proxy URL (Cloudflare Worker — proxies Unsplash, NASA, and CARTO)
APP_MEDIA_PROXY_URL=https://startgrid-api-proxy.startgrid.workers.dev

# CARTO basemap API key (Rain Radar widget's map tiles) — free, get one at
# carto.com/basemaps/apikey. Only consulted when APP_MEDIA_PROXY_URL above is
# unset (local dev without a proxy); otherwise set as a Worker secret instead
# (see worker/wrangler.toml). Without either, tiles load but show an
# "API KEY REQUIRED" watermark.
APP_CARTO_API_KEY=