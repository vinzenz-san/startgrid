{
  "manifest_version": 3,
  "name": "StartGrid - A New Tab",
  "description": "Customizable new tab page with widgets",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "identity",
    "search"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*"
  ]
}
